{
  "name": "test-task-teaboom",
  "version": "1.0.0",
  "description": "ТЗ — карточка товара Teaboom.ru",
  "homepage": "https://elenaiartseva.github.io/teaboom/",
  "scripts": {
    "build": "npm run build:css && node scripts/copy-build.js",
    "build:css": "sass scss/main.scss css/main.css --style=expanded",
    "watch:css": "sass scss/main.scss css/main.css --watch --style=expanded",
    "start": "npx --yes serve .",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "sass": "^1.77.0"
  }
}
